# Copy this file to .env. The resulting .env file is git-ignored.
TVPLAYER_TVH_URL=http://tvheadend.local:9981
TVPLAYER_TVH_USERNAME=
TVPLAYER_TVH_PASSWORD=
TVPLAYER_TVH_PROFILE=pass
# Leave empty to advertise the container's generated XMLTV cache.
TVPLAYER_XMLTV_URL=
TVPLAYER_GUIDE_PORT=49382
TVPLAYER_GUIDE_REFRESH_SECONDS=60
TVPLAYER_GUIDE_RETENTION_HOURS=24
TVPLAYER_GUIDE_FUTURE_HOURS=72
TVPLAYER_GUIDE_EVENT_LIMIT=50000
TVPLAYER_MDNS_NAME=TVPlayer TVHeadend
# Optional IPv4 address advertised for the service. By default the URL host is resolved.
TVPLAYER_MDNS_ADDRESS=
